# ==============================================================================
# SENTINEL Environment Configuration
# ==============================================================================

# Nebius Token Factory / Nebius Studio API Configuration
# Get your API key from https://tokenfactory.nebius.com or https://studio.nebius.ai
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL for Nebius Token Factory inference
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron Model ID on Nebius Token Factory
NEMOTRON_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct

# Database & Runtime Configuration
SENTINEL_DB_PATH=sentinel.db
SENTINEL_PORT=8000
APPROVAL_EXPIRY_SECONDS=300
VERIFICATION_PROBE_INTERVAL_SECONDS=10.0
